{
  "spec_name": "TeraPublic Conceptual Database Schema",
  "spec_version": "1.2-apbd",
  "status": "apbd-module",
  "database": "PostgreSQL",
  "notes": [
    "This is a conceptual schema, not executable DDL or Laravel migrations.",
    "Laravel migrations and Eloquent own the operational product schema.",
    "APBD records use the eight source dataset columns plus publication and provenance fields.",
    "The source fingerprint is indexed but non-unique; it reports duplicate candidates and never defines an APBD natural key.",
    "Project migrations remain historical; the forward-only APBD migration removes project tables and detaches legacy project feedback targets.",
    "Use one Admin role; citizen access rules are defined in docs/PROJECT_SPEC.md.",
    "ML use case and model are intentionally undecided pending dataset audit.",
    "Python AI service must not mutate Laravel-owned tables directly unless table ownership and service contract are explicitly documented."
  ],
  "enums": {
    "user_role": [
      "citizen",
      "admin"
    ],
    "publication_status": [
      "draft",
      "validating",
      "published",
      "superseded",
      "archived"
    ],
    "import_status": [
      "uploaded",
      "processing",
      "completed",
      "completed_with_errors",
      "failed"
    ],
    "feedback_status": [
      "submitted",
      "in_review",
      "in_progress",
      "resolved",
      "rejected"
    ],
    "chat_message_role": [
      "user",
      "assistant"
    ]
  },

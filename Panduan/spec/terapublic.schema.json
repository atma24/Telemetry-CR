    {
      "name": "apbd",
      "purpose": "Source-backed regional budget dataset rows with draft, validation, publication, provenance, and revision history",
      "fields": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "periode_data", "type": "varchar(6)", "required": true },
        { "name": "tanggal", "type": "date", "required": true },
        { "name": "kode_opd", "type": "varchar(100)", "required": true },
        { "name": "nama_opd", "type": "varchar(255)", "required": true },
        { "name": "akun_jenis", "type": "varchar(100)", "required": true },
        { "name": "nama_akun", "type": "varchar(255)", "required": true },
        { "name": "anggaran", "type": "decimal(38,2)", "required": true },
        { "name": "realisasi", "type": "decimal(38,2)", "required": true },
        { "name": "source_fingerprint", "type": "varchar(64)", "required": true, "indexed": true, "unique": false },
        { "name": "revises_id", "type": "uuid", "fk": "apbd.id", "nullable": true },
        { "name": "source_id", "type": "uuid", "fk": "data_sources.id", "nullable": true },
        { "name": "import_job_id", "type": "uuid", "fk": "import_jobs.id", "nullable": true },
        { "name": "source_original_data", "type": "jsonb", "nullable": true },
        { "name": "publication_status", "type": "publication_status", "required": true },
        { "name": "created_by", "type": "uuid", "fk": "users.id", "required": true },
        { "name": "reviewed_by", "type": "uuid", "fk": "users.id", "nullable": true },
        { "name": "published_at", "type": "timestamptz", "nullable": true },
        { "name": "created_at", "type": "timestamp", "nullable": true },
        { "name": "updated_at", "type": "timestamp", "nullable": true }
      ],
      "constraints": [
        "periode_data uses YYYYMM with a valid month",
        "anggaran and realisasi must be nonnegative",
        "source_fingerprint is a non-unique duplicate-candidate index; duplicates are reported and not overwritten during import",
        "A correction of a published row is drafted as a revision; the previous row remains public until publication",
        "No unique constraint is inferred for a combination of APBD dataset columns"
      ]
    },

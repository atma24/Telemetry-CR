erDiagram
    %% APBD source columns are retained as provided. Fingerprints are non-unique duplicate candidates, not a business key.
    %% No uniqueness is inferred from combinations of the eight APBD data fields.
    USERS {
        uuid id PK
        string name
        string email UK
        string password_hash
        string role
        string account_status
        datetime created_at
    }
    SESSIONS {
        string id PK
        uuid user_id FK
        string ip_address
        text user_agent
        text payload
        int last_activity
    }
    PERSONAL_ACCESS_TOKENS {
        bigint id PK
        string tokenable_type
        uuid tokenable_id
        text name
        string token UK
        text abilities
        datetime last_used_at
        datetime expires_at
        datetime created_at
        datetime updated_at
    }
    REGIONS {
        uuid id PK
        datetime created_at
    }
    REGION_VERSIONS {
        uuid id PK
        uuid region_id FK
        int version_no
        string code
        string name
        string level
        uuid parent_region_id FK
        uuid source_id FK
        uuid import_job_id FK
        json source_original_data
        string publication_status
        uuid created_by FK
        uuid reviewed_by FK
        datetime published_at
    }
    CATEGORIES {
        uuid id PK
        uuid parent_id FK
        string name
        string slug UK
    }
    DATA_SOURCES {
        uuid id PK
        string name
        string source_type
        string source_url
        text license_info
    }
    FACILITIES {
        uuid id PK
        string external_key
        datetime created_at
    }
    FACILITY_VERSIONS {
        uuid id PK
        uuid facility_id FK
        int version_no
        string name
        uuid category_id FK
        uuid region_id FK
        string address
        decimal latitude
        decimal longitude
        json attributes
        uuid source_id FK
        uuid import_job_id FK
        json source_original_data
        string publication_status
        uuid created_by FK
        uuid reviewed_by FK
        datetime published_at
    }
    APBD {
        uuid id PK
        string periode_data
        date tanggal
        string kode_opd
        string nama_opd
        string akun_jenis
        string nama_akun
        decimal anggaran
        decimal realisasi
        string source_fingerprint "indexed, non-unique"
        uuid revises_id FK
        uuid source_id FK
        uuid import_job_id FK
        json source_original_data
        string publication_status
        uuid created_by FK
        uuid reviewed_by FK
        datetime published_at
        datetime created_at
        datetime updated_at
    }
    DATASETS {
        uuid id PK
        string title
        string slug UK
        text description
        uuid category_id FK
        string lifecycle_status
        uuid created_by FK
        datetime created_at
    }
    DATASET_VERSIONS {
        uuid id PK
        uuid dataset_id FK
        int version_no
        uuid base_version_id FK
        uuid source_id FK
        uuid import_job_id FK
        string publication_status
        json schema_definition
        string original_file_path
        uuid created_by FK
        uuid reviewed_by FK
        datetime published_at
    }
    DATASET_ROWS {
        uuid id PK
        uuid dataset_version_id FK
        int row_number
        json row_data
        string validation_status
        json validation_errors
    }
    IMPORT_JOBS {
        uuid id PK
        string target_type
        uuid source_id FK
        string original_filename
        string file_path
        string status
        int total_rows
        int processed_rows
        int accepted_rows
        int rejected_rows
        text error_report_path
        text failure_reason
        uuid initiated_by FK
        datetime created_at
        datetime updated_at
        datetime finished_at
    }
    FEEDBACKS {
        uuid id PK
        uuid user_id FK
        uuid facility_id FK
        uuid apbd_id FK
        uuid region_id FK
        uuid dataset_id FK
        string subject
        text message
        string status
        text rejection_reason
        datetime created_at
        datetime updated_at
    }
    FEEDBACK_EVENTS {
        uuid id PK
        uuid feedback_id FK
        uuid actor_user_id FK
        string old_status
        string new_status
        text response_message
        datetime created_at
    }
    AUDIT_LOGS {
        uuid id PK
        uuid actor_user_id FK
        string action
        string entity_type
        uuid entity_id
        json old_data
        json new_data
        datetime created_at
    }
    KNOWLEDGE_DOCUMENTS {
        uuid id PK
        uuid source_id FK
        string title
        string file_path
        string processing_status
        uuid created_by FK
        datetime created_at
    }
    DOCUMENT_CHUNKS {
        uuid id PK
        uuid document_id FK
        int chunk_index
        text content
        string embedding_reference
        json metadata
    }
    CHAT_SESSIONS {
        uuid id PK
        uuid user_id FK
        string title
        datetime created_at
    }
    CHAT_MESSAGES {
        uuid id PK
        uuid session_id FK
        string role
        text content
        datetime created_at
    }
    CHAT_MESSAGE_SOURCES {
        uuid id PK
        uuid message_id FK
        uuid chunk_id FK
        int citation_number
    }

    USERS o|--o{ SESSIONS : has_sessions
    USERS ||--o{ PERSONAL_ACCESS_TOKENS : owns_api_tokens
    USERS o|--o{ REGION_VERSIONS : creates
    USERS o|--o{ REGION_VERSIONS : reviews
    REGIONS ||--|{ REGION_VERSIONS : has_versions
    REGIONS o|--o{ REGION_VERSIONS : parent_of
    DATA_SOURCES o|--o{ REGION_VERSIONS : sourced_from
    IMPORT_JOBS o|--o{ REGION_VERSIONS : imported_by

    CATEGORIES o|--o{ CATEGORIES : parent_category
    CATEGORIES ||--o{ DATASETS : categorizes
    USERS ||--o{ DATASETS : creates

    FACILITIES ||--|{ FACILITY_VERSIONS : has_versions
    REGIONS ||--o{ FACILITY_VERSIONS : located_in
    CATEGORIES ||--o{ FACILITY_VERSIONS : classifies
    DATA_SOURCES o|--o{ FACILITY_VERSIONS : sourced_from
    IMPORT_JOBS o|--o{ FACILITY_VERSIONS : imported_by
    USERS ||--o{ FACILITY_VERSIONS : creates
    USERS o|--o{ FACILITY_VERSIONS : reviews

    APBD o|--o{ APBD : revises
    DATA_SOURCES o|--o{ APBD : sourced_from
    IMPORT_JOBS o|--o{ APBD : imported_by
    USERS ||--o{ APBD : creates
    USERS o|--o{ APBD : reviews

    DATASETS ||--|{ DATASET_VERSIONS : has_versions
    DATASET_VERSIONS o|--o{ DATASET_VERSIONS : based_on
    DATASET_VERSIONS ||--o{ DATASET_ROWS : contains
    DATA_SOURCES o|--o{ DATASET_VERSIONS : sourced_from
    IMPORT_JOBS o|--o{ DATASET_VERSIONS : imported_by
    USERS ||--o{ DATASET_VERSIONS : creates
    USERS o|--o{ DATASET_VERSIONS : reviews
    DATA_SOURCES o|--o{ IMPORT_JOBS : sourced_from
    USERS ||--o{ IMPORT_JOBS : starts

    USERS ||--o{ FEEDBACKS : submits
    FACILITIES o|--o{ FEEDBACKS : concerns
    APBD o|--o{ FEEDBACKS : concerns
    REGIONS o|--o{ FEEDBACKS : concerns
    DATASETS o|--o{ FEEDBACKS : concerns
    FEEDBACKS ||--o{ FEEDBACK_EVENTS : has_history
    USERS ||--o{ FEEDBACK_EVENTS : acts
    USERS o|--o{ AUDIT_LOGS : performs

    DATA_SOURCES o|--o{ KNOWLEDGE_DOCUMENTS : references
    USERS ||--o{ KNOWLEDGE_DOCUMENTS : manages
    KNOWLEDGE_DOCUMENTS ||--o{ DOCUMENT_CHUNKS : splits_into
    USERS ||--o{ CHAT_SESSIONS : owns
    CHAT_SESSIONS ||--|{ CHAT_MESSAGES : contains
    CHAT_MESSAGES ||--o{ CHAT_MESSAGE_SOURCES : cites
    DOCUMENT_CHUNKS ||--o{ CHAT_MESSAGE_SOURCES : referenced_by
